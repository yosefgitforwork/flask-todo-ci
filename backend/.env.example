# Copy to `.env` and adjust as needed.
# docker-compose sets these for the container; this file documents them and is
# used for local (non-Docker) development.

# Which config the factory loads: dev | test | prod
FLASK_CONFIG=

# Lets the `flask db ...` CLI discover the app factory via wsgi.py
FLASK_APP=wsgi.py

# --- MySQL connection (used by the dev/prod configs) --------------------------
# Defaults baked into the app are root / 12345 / mysql / flask. The values below
# match the docker-compose mysql service.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
